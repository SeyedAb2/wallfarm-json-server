{
  "swagger": "2.0",
  "info": {
    "title": "AgriMarket Mock API",
    "version": "1.0.0",
    "description": "Swagger API documentation for Users and Products (json-server mock)."
  },
  "basePath": "/api",
  "schemes": ["https"],
  "tags": [
    { "name": "Users" },
    { "name": "Products" }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/User" }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user",
        "parameters": [
          {
            "in": "body",
            "name": "user",
            "required": true,
            "schema": { "$ref": "#/definitions/User" }
          }
        ],
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "schema": { "$ref": "#/definitions/User" }
          },
          "404": { "description": "User not found" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update user partially",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          { "in": "body", "name": "user", "required": true, "schema": { "$ref": "#/definitions/User" } }
        ],
        "responses": {
          "200": { "description": "User updated" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": {
          "200": { "description": "User deleted" },
          "404": { "description": "User not found" }
        }
      }
    },

    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get all products",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Product" }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a new product",
        "parameters": [
          {
            "in": "body",
            "name": "product",
            "required": true,
            "schema": { "$ref": "#/definitions/Product" }
          }
        ],
        "responses": {
          "201": { "description": "Product created" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": {
          "200": {
            "description": "Product found",
            "schema": { "$ref": "#/definitions/Product" }
          },
          "404": { "description": "Product not found" }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update product partially",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          { "in": "body", "name": "product", "required": true, "schema": { "$ref": "#/definitions/Product" } }
        ],
        "responses": {
          "200": { "description": "Product updated" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete product by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": {
          "200": { "description": "Product deleted" },
          "404": { "description": "Product not found" }
        }
      }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "confirmPassword": { "type": "string" },
        "age": { "type": "integer" },
        "type": { "type": "string", "enum": ["farmer", "seller", "service"] },
        "logo": { "type": "string" },
        "address": { "type": "string" },
        "description": { "type": "string" },
        "social": {
          "type": "object",
          "properties": {
            "telegram": { "type": "string" },
            "instagram": { "type": "string" },
            "twitter": { "type": "string" }
          }
        }
      }
    },
    "Product": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string" },
        "price": { "type": "string" },
        "grade": { "type": "integer" },
        "info": { "type": "string" },
        "type": { "type": "string", "enum": ["tools", "grand", "produce", "supple"] },
        "image": { "type": "string" },
        "address": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "user": { "$ref": "#/definitions/User" },
        "additional_data": {
          "type": "object",
          "description": "Dynamic fields depending on product type (tools, produce, supple, grand)."
        }
      }
    }
  }
}
